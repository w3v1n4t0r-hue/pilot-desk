---
import { footerLinks } from '../data/site.mjs';
---
<footer>
  <div>
    <b>PilotDesk</b>
    <p>Flight planning, calculation, weather, and study tools.</p>
  </div>
  <div class="footer-links">
    {footerLinks.map(([href, label]) => <a href={href}>{label}</a>)}
  </div>
  <p class="fine">PilotDesk supplements, but does not replace, official flight planning, weather, aircraft, regulatory, or operational sources.</p>
</footer>
