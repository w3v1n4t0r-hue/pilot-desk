---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeActions, popularTools, homeCategories } from '../data/site.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      description: 'Free aviation calculators, flight planning, weather tools, and pilot training.'
    },
    {
      '@type': 'Organization',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      logo: { '@type': 'ImageObject', url: 'https://www.pilot-desk.com/assets/icon.svg' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What aviation tools does PilotDesk include?', 'PilotDesk brings together flight planning, aviation calculators, weather references, aircraft performance tools, and pilot study resources.'],
        ['What is PilotDesk Daily?', 'PilotDesk Daily is a free three-question aviation challenge that changes every day. Pilots can share their score and challenge another pilot, while signed-in users can also save XP and streaks.'],
        ['Are PilotDesk calculator results official operational data?', 'No. Results are planning aids based on the inputs and methods shown on each tool. Verify operational decisions with current approved aircraft, airport, weather, and regulatory sources.'],
        ['Can I use PilotDesk for FAA written test preparation?', 'Yes. PilotDesk includes rating-focused practice for common FAA written-test subjects, with explanations and weak-area review.']
      ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
    }
  ]
};
---
<BaseLayout
  title="PilotDesk | Flight Planning, Aviation Calculators & Pilot Training"
  description="Plan flights, run aviation calculations, check weather, study FAA written-test subjects, and play PilotDesk Daily."
  canonical="/"
  schema={schema}
  bodyClass="pd-home-2026"
>
  <section class="pd-home-hero" aria-labelledby="pdHomeTitle">
    <div class="pd-home-hero-inner">
      <div class="pd-home-hero-copy">
        <div class="eyebrow">PILOT TOOLS · PLANNING · TRAINING</div>
        <h1 id="pdHomeTitle">Plan the flight. Run the numbers. Keep learning.</h1>
        <p>PilotDesk puts flight planning, aviation calculators, weather, and pilot training in one fast workspace. Start with the task you need right now.</p>
      </div>
      <div class="pd-home-actions">
        {homeActions.slice(0,3).map(([href, title, copy, path], index) => (
          <a class="pd-home-action" href={href} data-pd-home-cta={title} data-pd-launch={index === 2 ? 'written-prep' : undefined}>
            <span class="pd-home-action-icon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg></span>
            <b>{title}</b><span>{copy}</span><em aria-hidden="true">›</em>
          </a>
        ))}
      </div>
      <div class="pd-home-proof" aria-label="PilotDesk basics">
        <span><strong>Free core tools</strong><small>No sign-in required</small></span>
        <span><strong>Built for pilots</strong><small>Planning, math, weather, training</small></span>
        <span><strong>Methods shown</strong><small>Verify with approved sources</small></span>
      </div>
    </div>
  </section>

  <div class="pd-home-wrap">
    <section class="pd-home-section pd-learning-promo pd-daily-home" aria-labelledby="pdDailyHomeTitle">
      <div>
        <div class="eyebrow">PILOTDESK DAILY · TODAY'S CHALLENGE</div>
        <h2 id="pdDailyHomeTitle">Three questions. Then challenge another pilot.</h2>
        <p>Weather, performance, systems, airport operations, and aeronautical decision making. Everyone gets the same daily challenge, and your finished score can be shared in one tap.</p>
        <div class="pd-actions">
          <a class="pd-btn" href="/daily/" data-pd-home-cta="Play Daily">Play today's pilot quiz</a>
          <a href="/skill-gap.html" data-pd-home-cta="Skill Gap">Find your weak subjects →</a>
        </div>
      </div>
    </section>

    <section class="pd-home-section" id="pdResume" hidden><h2>Pick up where you left off</h2><div id="pdResumeItems" class="pd-resume-items"></div><p class="fine">Recent tools and flights are saved on this device.</p></section>
    <section class="pd-home-section" id="popular-tools">
      <div class="pd-home-section-head">
        <div><h2>Popular tools</h2><p>Run the calculation, then share the exact setup with another pilot.</p></div>
        <a href="/tools.html" data-pd-home-cta="All Calculators">All calculators →</a>
      </div>
      <div class="pd-popular-grid">
        {popularTools.map(([href, title, path]) => (
          <a class="pd-popular-tool" href={href}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span>{title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pd-home-section pd-learning-promo"><div><div class="eyebrow">LEARN A LITTLE, EVERY DAY</div><h2>Make your next study session count.</h2><p>Choose your rating, try a sample, and build confidence with explanations and weak-area review.</p><a class="pd-btn" href="/flight-training.html" data-pd-home-cta="Study Path">Find your study path</a> <a href="/daily/" data-pd-home-cta="Play Daily">Play Daily →</a></div></section>

    <section class="pd-home-section pd-learning-promo" data-pd-home-account aria-label="PilotDesk account">
      <div>
        <div class="eyebrow">SAVE YOUR PROGRESS</div>
        <h2 data-pd-home-account-title>Make PilotDesk yours when you're ready.</h2>
        <p data-pd-home-account-copy>Core tools work without an account. Sign in when you want written-prep scores, Daily streaks, aircraft, and progress to follow you between devices.</p>
        <div class="pd-actions" data-pd-home-account-actions>
          <a class="pd-btn secondary" href="/account.html?next=%2F" data-pd-home-cta="Sign In">Sign in</a>
          <a href="/account.html?next=%2F" data-pd-home-cta="Create Account">Create a free account →</a>
        </div>
      </div>
    </section>

    <section class="pd-home-section pd-home-discovery"><div class="pd-home-section-head"><div><h2>Explore PilotDesk</h2><p>Move from today’s task to the next useful step.</p></div></div><div class="pd-popular-grid"><a class="pd-popular-tool" href="/written-prep.html"><span><b>Written Prep</b><small>Practice PPL through ATP subjects.</small></span></a><a class="pd-popular-tool" href="/daily/"><span><b>PilotDesk Daily</b><small>Three aviation questions, shareable scores, and a learning streak.</small></span></a><a class="pd-popular-tool" href="/flight-training.html"><span><b>Flight Training</b><small>Organize your study path by rating.</small></span></a><a class="pd-popular-tool" href="/for-cfis.html"><span><b>CFI Toolkit</b><small>Five shareable tools for instructors and students.</small></span></a></div></section>
    <section class="pd-home-section"><h2>Know where your numbers come from.</h2><p>Methods, assumptions, and source links accompany the tools. Use current approved information for operational decisions.</p><a href="/sources.html">Sources and methods →</a></section>
    <section class="pd-home-section pd-home-faq" aria-labelledby="faq-title"><div class="pd-home-section-head"><div><h2 id="faq-title">PilotDesk questions</h2><p>Short answers before you start planning or studying.</p></div></div><div class="pd-faq-list"><details><summary>What aviation tools does PilotDesk include?</summary><p>Flight planning, aviation calculators, weather references, aircraft performance tools, and pilot study resources.</p></details><details><summary>What is PilotDesk Daily?</summary><p>A free three-question aviation challenge that changes every day. Finish it, share your score, and challenge another pilot. Signed-in users can also save XP and streaks.</p></details><details><summary>Are calculator results official operational data?</summary><p>No. Results are planning aids based on the inputs and methods shown. Verify decisions with current approved aircraft, airport, weather, and regulatory sources.</p></details><details><summary>Can I use PilotDesk for FAA written test preparation?</summary><p>Yes. Rating-focused practice includes explanations and weak-area review.</p></details></div></section>
  </div>
</BaseLayout>
