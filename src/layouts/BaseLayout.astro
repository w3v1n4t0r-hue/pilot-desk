---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  canonical = Astro.url.pathname,
  robots = 'index,follow,max-image-preview:large',
  ogTitle = title,
  ogDescription = description,
  schema = null,
  bodyClass = ''
} = Astro.props;

const canonicalUrl = canonical.startsWith('http') ? canonical : new URL(canonical, Astro.site).href;
const schemas = !schema ? [] : Array.isArray(schema) ? schema : [schema];
---
<!doctype html>
<html lang="en" data-pd-astro-native="1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/assets/icon.svg" type="image/svg+xml" />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
    <script is:inline defer src="/assets/safety.js"></script>
    <script is:inline defer src="/assets/site.js"></script>
    <script is:inline defer src="/assets/ad-config.js"></script>
    <script is:inline defer src="/assets/ads.js"></script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main class="shell" id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline defer src="/assets/app-bootstrap.js"></script>
    <slot name="scripts" />
  </body>
</html>
