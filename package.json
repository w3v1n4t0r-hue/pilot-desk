{
  "name": "pilotdesk",
  "version": "2.0.0",
  "private": true,
  "description": "PilotDesk aviation calculators, planning tools, weather, and training",
  "scripts": {
    "dev": "npm run astro:prepare && astro dev",
    "astro:prepare": "node scripts/sync-navigation.mjs && node scripts/prepare-astro-public.mjs",
    "build": "npm run astro:prepare && astro build && node scripts/verify-astro-build.mjs",
    "preview": "astro preview",
    "test:interaction": "node qa/interaction-e2e.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "playwright": "1.55.0"
  }
}
