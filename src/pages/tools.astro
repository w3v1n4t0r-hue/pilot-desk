---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free Aviation Calculators for Pilots',
  url: 'https://www.pilot-desk.com/tools.html',
  description: 'Free browser-based aviation calculators for pilots and flight students.',
  isPartOf: { '@type': 'WebSite', name: 'PilotDesk', url: 'https://www.pilot-desk.com/' },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Popular PilotDesk aviation calculators',
    itemListElement: [
      ['Crosswind Component Calculator','https://www.pilot-desk.com/calculators/crosswind/'],
      ['Density Altitude Calculator','https://www.pilot-desk.com/calculators/density-altitude/'],
      ['Aircraft CG Calculator','https://www.pilot-desk.com/calculators/moment-cg/'],
      ['Rate of Turn Calculator','https://www.pilot-desk.com/calculators/rate-of-turn/'],
      ['ISA Temperature Calculator','https://www.pilot-desk.com/calculators/isa-temperature/'],
      ['3 Degree Descent Rate Calculator','https://www.pilot-desk.com/calculators/three-degree-descent/']
    ].map(([name,url],i)=>({ '@type':'ListItem', position:i+1, name, url }))
  }
};
---
<BaseLayout
  title="Free Aviation Calculators for Pilots | PilotDesk"
  description="Free aviation calculators for pilots and flight students: crosswind, density altitude, E6B, weight and balance, fuel, descent, turn, navigation, and conversions."
  canonical="/tools.html"
  robots="index,follow,max-image-preview:large"
  schema={schema}
  bodyClass="pd-tools-page"
>
  <link slot="head" rel="stylesheet" href="/assets/home-desk.css" />
  <section class="pd-page-hero">
    <div class="eyebrow">Flight calculations</div>
    <h1>Aviation calculators.</h1>
    <p>Wind, altitude, fuel, loading and navigation. Pick a tool or search below.</p>
  </section>
  <section class="pd-tool-finder" aria-labelledby="pdToolFinderTitle">
    <div class="pd-tool-finder-head">
      <div><h2 id="pdToolFinderTitle">What do you need to calculate?</h2><p>Search by name or choose a category.</p></div>
      <span id="pdToolCount" aria-live="polite">Loading tools…</span>
    </div>
    <div class="pd-tool-search-row">
      <label class="skip-link" for="pdToolDirectorySearch">Search aviation calculators</label>
      <input id="pdToolDirectorySearch" type="search" placeholder="Search calculators" autocomplete="off" enterkeyhint="search" />
      <label class="skip-link" for="pdToolDirectoryGroup">Filter calculators by category</label>
      <select id="pdToolDirectoryGroup"><option value="">All categories</option></select>
      <button class="utility-btn" id="pdToolClear" type="button" hidden>Clear</button>
    </div>
    <div class="pd-tool-chips" id="pdToolChips" aria-label="Quick calculator filters"></div>
  </section>
  <section class="pd-seo-tool-intro" aria-label="Popular aviation calculators">
    <div><span class="eyebrow">Frequently used</span><h2>Common pilot calculations.</h2><p>Open a calculator and enter your own values.</p></div>
    <div class="pd-seo-tool-links">
      <a href="/calculators/crosswind/">Crosswind component</a><a href="/calculators/density-altitude/">Density altitude</a><a href="/e6b-flight-computer.html">Online E6B</a><a href="/calculators/moment-cg/">Aircraft CG</a><a href="/calculators/isa-temperature/">ISA temperature</a><a href="/calculators/rate-of-turn/">Rate of turn</a><a href="/calculators/three-degree-descent/">3° descent rate</a><a href="/weight-balance.html">Weight &amp; balance</a>
    </div>
  </section>



  <section class="pd-tool-personal" id="pdToolPersonal" hidden aria-labelledby="pdToolPersonalTitle">
    <div class="pd-tool-personal-head"><div><div class="eyebrow">RECENTLY USED</div><h2 id="pdToolPersonalTitle">Back to the calculators you use.</h2></div><span>Saved on this device</span></div>
    <div class="pd-tool-personal-grid" id="pdToolPersonalGrid"></div>
  </section>

  <div id="pdToolDirectory" aria-live="polite"></div>
  <section class="pd-seo-tool-footer">
    <div><span class="eyebrow">PILOT MATH &amp; TRAINING</span><h2>Pilot guides</h2><p>Wind, performance, weather and checkride study.</p></div>
    <div class="pd-seo-tool-links"><a href="/guides/pilot-math-formulas.html">Pilot math formulas</a><a href="/guides/aircraft-performance-reference.html">Aircraft performance</a><a href="/guides/navigation-reference.html">Navigation reference</a><a href="/guides/aviation-weather-reference.html">Aviation weather</a><a href="/flight-training.html">Checkride study hubs</a><a href="/written-prep.html">FAA written prep</a></div>
  </section>
  <script slot="scripts" is:inline defer src="/assets/tools-directory.js"></script>
  <script>import "../scripts/design-motion.js";</script>
</BaseLayout>
