---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Aviation Calculators | PilotDesk"
  description="Browse PilotDesk aviation calculators for flight planning, performance, navigation, weather, weight and balance, and conversions."
  canonical="/tools.html"
  robots="index,follow"
>
  <section class="pd-page-hero">
    <div class="eyebrow">AVIATION CALCULATORS</div>
    <h1>Find the calculation you need.</h1>
    <p>Search by what you're trying to solve—not by remembering a calculator name. Flight planning, performance, navigation, weather, weight and balance, and conversions are all here.</p>
  </section>
  <section class="pd-tool-finder" aria-labelledby="pdToolFinderTitle">
    <div class="pd-tool-finder-head">
      <div><h2 id="pdToolFinderTitle">What do you need to calculate?</h2><p>Try “crosswind,” “fuel,” “CG,” “ft/NM,” “groundspeed,” or “descent.”</p></div>
      <span id="pdToolCount" aria-live="polite">Loading tools…</span>
    </div>
    <div class="pd-tool-search-row">
      <label class="skip-link" for="pdToolDirectorySearch">Search aviation calculators</label>
      <input id="pdToolDirectorySearch" type="search" placeholder="Search by task, formula, or topic" autocomplete="off" enterkeyhint="search" />
      <label class="skip-link" for="pdToolDirectoryGroup">Filter calculators by category</label>
      <select id="pdToolDirectoryGroup"><option value="">All categories</option></select>
      <button class="utility-btn" id="pdToolClear" type="button" hidden>Clear</button>
    </div>
    <div class="pd-tool-chips" id="pdToolChips" aria-label="Quick calculator filters"></div>
  </section>

  <section class="pd-tool-personal" id="pdToolPersonal" hidden aria-labelledby="pdToolPersonalTitle">
    <div class="pd-tool-personal-head"><div><div class="eyebrow">RECENTLY USED</div><h2 id="pdToolPersonalTitle">Back to the calculators you use.</h2></div><span>Saved on this device</span></div>
    <div class="pd-tool-personal-grid" id="pdToolPersonalGrid"></div>
  </section>

  <div id="pdToolDirectory" aria-live="polite"></div>
  <script slot="scripts" is:inline defer src="/assets/tools-directory.js"></script>
</BaseLayout>
