---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeActions, popularTools } from '../data/site.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      description: 'Free aviation calculators, flight planning, weather tools, FAA-based pilot training, and optional Pro continuity in one workspace.'
    },
    {
      '@type': 'Organization',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      logo: { '@type': 'ImageObject', url: 'https://www.pilot-desk.com/assets/icon.svg' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What is PilotDesk?', 'PilotDesk is a browser-based aviation workspace for flight planning, pilot calculations, weather, and training.'],
        ['Do I need an account?', 'No. Core tools work without an account. A free account can keep study progress and Daily history together, while PilotDesk Pro adds cross-device planning continuity.'],
        ['Are PilotDesk calculator results official operational data?', 'No. PilotDesk is a planning and training aid. Verify operational decisions with current approved aircraft data, weather, procedures, regulations, and official sources.'],
        ['What is PilotDesk Daily?', 'PilotDesk Daily is a short aviation challenge with three new questions each day.']
      ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
    }
  ]
};
---
<BaseLayout
  title="Free Aviation Calculators, Flight Planning & Training | PilotDesk"
  description="Free aviation calculators, flight planning, weather, written prep, and checkride study tools for student pilots, instrument pilots, commercial pilots, and CFIs."
  canonical="/"
  schema={schema}
  bodyClass="pd-home-2026"
>
  <section class="pd-home-hero" aria-labelledby="pdHomeTitle">
    <div class="pd-home-hero-inner">
      <div class="pd-home-hero-copy">
        <div class="eyebrow">PILOT TOOLS, IN ONE PLACE</div>
        <h1 id="pdHomeTitle">Plan, calculate, check weather, and study without bouncing between sites.</h1>
        <p>Open the tool you need and get to work. Core PilotDesk tools stay usable without an account.</p>
        <div class="pd-home-hero-links">
          <a class="pd-btn" href="/route-planner.html" data-pd-home-cta="Start Planning">Plan a flight</a>
          <a class="pd-home-text-link" href="/tools.html" data-pd-home-cta="Browse Tools">Browse all tools →</a>
        </div>
      </div>

      <div class="pd-home-actions" aria-label="Quick start">
        {homeActions.slice(0,3).map(([href, title, copy, path], index) => (
          <a class="pd-home-action" href={href} data-pd-home-cta={title} data-pd-launch={index === 2 ? 'written-prep' : undefined}>
            <span class="pd-home-action-icon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg></span>
            <span class="pd-home-action-copy"><b>{title}</b><span>{copy}</span></span>
            <em aria-hidden="true">↗</em>
          </a>
        ))}
      </div>

      <div class="pd-home-proof" aria-label="PilotDesk basics">
        <span><strong>Free core tools</strong><small>No account required</small></span>
        <span><strong>Aviation focused</strong><small>Planning, math, weather, training</small></span>
        <span><strong>Sources shown</strong><small>Verify operational decisions</small></span>
      </div>
    </div>
  </section>

  <div class="pd-home-wrap">
    <section class="pd-home-section pd-first-run" id="pdFirstRun" aria-labelledby="pdFirstRunTitle">
      <div class="pd-home-section-head">
        <div>
          <div class="eyebrow">START WITH THE JOB</div>
          <h2 id="pdFirstRunTitle">What are you working on?</h2>
          <p>Pick the task.</p>
        </div>
        <button class="utility-btn" type="button" id="pdFirstRunReset" hidden>Change</button>
      </div>

      <div class="pd-first-run-grid" role="list">
        <a href="/route-planner.html" data-pd-first-goal="plan" role="listitem">
          <small>PLAN</small><b>Build a flight</b><span>Route, airports, weather, procedures, aircraft, and a saved brief.</span><em>Open flight planning →</em>
        </a>
        <a href="/tools.html" data-pd-first-goal="calculate" role="listitem">
          <small>CALCULATE</small><b>Run the numbers</b><span>Crosswind, density altitude, fuel, climb, W&B, E6B, conversions, and more.</span><em>Find a calculator →</em>
        </a>
        <a href="/flight-training.html" data-pd-first-goal="study" role="listitem">
          <small>STUDY</small><b>Study for the next rating</b><span>Written prep, weak-area review, oral practice, rating hubs, and PilotDesk Daily.</span><em>Open training →</em>
        </a>
        <a href="/for-cfis.html" data-pd-first-goal="teach" role="listitem">
          <small>TEACH</small><b>Teach with it</b><span>Share scenarios, calculator setups, and training resources with a student.</span><em>Open CFI tools →</em>
        </a>
      </div>
      <div class="pd-first-run-selected" id="pdFirstRunSelected" hidden aria-live="polite"></div>
    </section>

    <section class="pd-home-section" id="popular-tools">
      <div class="pd-home-section-head">
        <div>
          <div class="eyebrow">QUICK ACCESS</div>
          <h2>Popular tools pilots come back for</h2>
          <p>Open a tool and use it.</p>
        </div>
        <a href="/tools.html" data-pd-home-cta="All Calculators">All calculators →</a>
      </div>
      <div class="pd-popular-grid">
        {popularTools.map(([href, title, path]) => (
          <a class="pd-popular-tool" href={href} data-pd-home-cta={title}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span>{title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pd-home-section pd-home-two-up" aria-label="Training and daily challenge">
      <article class="pd-home-feature">
        <div class="eyebrow">PILOTDESK DAILY</div>
        <h2>Three aviation questions each day.</h2>
        <p>A short daily check across weather, systems, performance, regulations, and decision making.</p>
        <div class="pd-actions">
          <a class="pd-btn" href="/daily/" data-pd-home-cta="Play Daily">Play Daily →</a>
          <a href="/skill-gap.html" data-pd-home-cta="Skill Gap">See your weak subjects →</a>
        </div>
      </article>

      <article class="pd-home-feature">
        <div class="eyebrow">TRAINING</div>
        <h2>Study by certificate or rating.</h2>
        <p>Written prep, oral practice, FAA references, and checkride guides stay grouped around the rating you are working on.</p>
        <div class="pd-actions">
          <a class="pd-btn secondary" href="/flight-training.html" data-pd-home-cta="Training Hub">Open training</a>
          <a href="/written-prep.html" data-pd-home-cta="Written Prep">Written prep →</a>
        </div>
      </article>
    </section>

    <section class="pd-home-section pd-home-business" aria-labelledby="pdBusinessTitle">
      <div>
        <div class="eyebrow">FOR CFIS & FLIGHT SCHOOLS</div>
        <h2 id="pdBusinessTitle">Use PilotDesk with students.</h2>
        <p>Share tools, training resources, and embeddable calculators for lessons or school websites.</p>
      </div>
      <div class="pd-home-business-actions">
        <a class="pd-btn" href="/for-flight-schools.html" data-pd-home-cta="Flight Schools">Flight school options</a>
        <a href="/pricing.html" data-pd-home-cta="Plans">Compare Free, Pro & Flight School →</a>
      </div>
    </section>

    <section class="pd-home-section" id="pdResume" hidden>
      <h2>Pick up where you left off</h2>
      <div id="pdResumeItems" class="pd-resume-items"></div>
      <p class="fine">Recent tools and flights are saved on this device.</p>
    </section>

    <section class="pd-home-section pd-home-discovery" aria-labelledby="pdExploreTitle">
      <div class="pd-home-section-head">
        <div><div class="eyebrow">MORE PILOTDESK</div><h2 id="pdExploreTitle">Explore PilotDesk</h2><p>Go deeper without turning the homepage into a directory.</p></div>
      </div>
      <div class="pd-popular-grid">
        <a class="pd-popular-tool" href="/written-prep.html" data-pd-home-cta="Written Prep"><span><b>Written Prep</b><small>Study by rating and FAA standard.</small></span></a>
        <a class="pd-popular-tool" href="/daily/" data-pd-home-cta="PilotDesk Daily"><span><b>PilotDesk Daily</b><small>Three new aviation questions each day.</small></span></a>
        <a class="pd-popular-tool" href="/aircraft.html" data-pd-home-cta="Aircraft"><span><b>Aircraft</b><small>Keep planning numbers and profiles together.</small></span></a>
        <a class="pd-popular-tool" href="/pricing.html" data-pd-home-cta="Plans"><span><b>Plans</b><small>Free, Pro, and Flight School direction.</small></span></a>
      </div>
    </section>

    <section class="pd-home-section pd-home-account" data-pd-home-account aria-label="PilotDesk account">
      <div>
        <div class="eyebrow">OPTIONAL ACCOUNT</div>
        <h2 data-pd-home-account-title>Sign in only when you want syncing.</h2>
        <p data-pd-home-account-copy>Accounts sync study progress, Daily history, aircraft, and saved work across devices. Core tools still work without one.</p>
      </div>
      <div class="pd-home-business-actions" data-pd-home-account-actions>
        <a class="pd-btn secondary" href="/account.html?next=%2F" data-pd-home-cta="Create Account">Create a free account</a>
        <a href="/account.html?next=%2F" data-pd-home-cta="Sign In">Sign in →</a>
      </div>
    </section>

    <section class="pd-home-section pd-home-trust">
      <div>
        <div class="eyebrow">SOURCE-FIRST</div>
        <h2>Know what the result is based on.</h2>
        <p>Methods, assumptions, and source links are shown where they matter. Verify flight-critical decisions with current approved sources.</p>
      </div>
      <a href="/sources.html">Read the sources and methods →</a>
    </section>

    <section class="pd-home-section pd-home-faq" aria-labelledby="faq-title">
      <div class="pd-home-section-head">
        <div><h2 id="faq-title">Common questions</h2></div>
      </div>
      <div class="pd-faq-list">
        <details><summary>What is PilotDesk?</summary><p>A browser-based aviation workspace for flight planning, pilot calculations, weather, and training.</p></details>
        <details><summary>Do I need an account?</summary><p>No. Core tools work without one. Sign in only when you want your progress, aircraft, and study history saved across devices.</p></details>
        <details><summary>Are calculator results official operational data?</summary><p>No. Use PilotDesk as a planning aid and verify operational decisions with current approved aircraft, airport, weather, procedural, and regulatory sources.</p></details>
        <details><summary>What is PilotDesk Daily?</summary><p>A three-question aviation challenge that changes every day.</p></details>
      </div>
    </section>
  </div>
</BaseLayout>
