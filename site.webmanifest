{
  "id": "/",
  "name": "PilotDesk",
  "short_name": "PilotDesk",
  "description": "Pilot tools for airport search, aviation weather, FAA chart route planning, saved flights, flight briefs, aircraft profiles, weight and balance, and pilot math.",
  "start_url": "/planner.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#08090b",
  "theme_color": "#08090b",
  "categories": [
    "navigation",
    "utilities",
    "education"
  ],
  "icons": [
    {
      "src": "/assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Airport Search",
      "short_name": "Airports",
      "description": "Search airports, weather, runways, nearby stations, and FAA procedures.",
      "url": "/airport.html",
      "icons": [
        {
          "src": "/assets/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Route Planner",
      "short_name": "Planner",
      "description": "Open the FAA chart route planner and navlog.",
      "url": "/route-planner.html",
      "icons": [
        {
          "src": "/assets/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Airport Weather",
      "short_name": "Weather",
      "description": "Open current METAR and TAF reports.",
      "url": "/weather.html",
      "icons": [
        {
          "src": "/assets/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Weight & Balance",
      "short_name": "W&B",
      "description": "Open the Weight & Balance Builder.",
      "url": "/calculators/weight-balance-builder/",
      "icons": [
        {
          "src": "/assets/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
