---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPrototype from '../components/HeroPrototype.astro';
import HomePlans from '../components/HomePlans.astro';
---
<BaseLayout
  title="Free Aviation Calculators, Flight Planning & Training | PilotDesk"
  description="Flight planning, aviation calculators, weather, and flight training in one workspace."
  canonical="/"
  schema={{'@context':'https://schema.org','@graph':[{'@type':'WebSite',name:'PilotDesk',url:'https://www.pilot-desk.com/'},{'@type':'Organization',name:'PilotDesk',url:'https://www.pilot-desk.com/',logo:'https://www.pilot-desk.com/favicon.svg'}]}}
  bodyClass="pd-home-2026 pd-hero-prototype"
>
  <link slot="head" rel="stylesheet" href="/assets/hero-prototype.css" />
  <script slot="head" is:inline>document.documentElement.classList.add('hp-enhance');</script>
  <HeroPrototype />
  <div class="pd-home-wrap"><HomePlans /></div>
</BaseLayout>
