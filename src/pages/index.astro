---
import BaseLayout from '../layouts/BaseLayout.astro';
import { popularTools } from '../data/site.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      description: 'Free aviation calculators, route planning, airport weather, and FAA-based study tools, with optional Pro cloud backup.'
    },
    {
      '@type': 'Organization',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      logo: { '@type': 'ImageObject', url: 'https://www.pilot-desk.com/favicon.svg' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What is PilotDesk?', 'PilotDesk is a browser-based set of aviation calculators, route-planning, weather, and study tools.'],
        ['Do I need an account?', 'No. Core tools work without an account. A free account saves Daily, Written Prep, and profile progress. PilotDesk Pro adds aircraft and saved-flight cloud backup plus ad-free signed-in use.'],
        ['Are PilotDesk calculator results official operational data?', 'No. PilotDesk is a planning and training aid. Verify operational decisions with current approved aircraft data, weather, procedures, regulations, and official sources.'],
        ['What is PilotDesk Daily?', 'PilotDesk Daily is a short aviation challenge with three new questions each day.']
      ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
    }
  ]
};
---
<BaseLayout
  title="Free Aviation Calculators, Flight Planning & Training | PilotDesk"
  description="Free aviation calculators, flight planning, weather, written prep, and checkride study tools for student pilots, instrument pilots, commercial pilots, and CFIs."
  canonical="/"
  schema={schema}
  bodyClass="pd-home-2026"
>
  <link slot="head" rel="stylesheet" href="/assets/home-desk.css" />
  <link slot="head" rel="stylesheet" href="/assets/home-product.css" />
  <section class="pd-home-hero" aria-labelledby="pdHomeTitle">
    <div class="pd-home-hero-inner">
      <div class="pd-home-hero-copy">
        <div class="eyebrow">PILOTDESK</div>
        <h1 id="pdHomeTitle">Flight planning and pilot tools.</h1>
        <p>Build a route, check the weather, run the numbers or study for your next checkride.</p>
        <nav class="pd-home-hero-links" aria-label="Start a pilot task">
          <a class="pd-btn" href="/route-planner.html" data-pd-home-cta="Start Planning">Plan a flight</a>
          <a class="pd-home-command" href="/weather.html" data-pd-home-cta="Weather">Check weather <span aria-hidden="true">↗</span></a>
          <a class="pd-home-command" href="/tools.html" data-pd-home-cta="Browse Tools">Open tools <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <section class="pd-home-product" aria-labelledby="pdHomeProductTitle">
        <div class="pd-home-product-head">
          <span>FLIGHT PLANNER / WORKSPACE</span>
          <span class="pd-home-product-tag">INTERFACE PREVIEW</span>
        </div>
        <div class="pd-home-product-title-row">
          <div>
            <div class="pd-home-product-overline">EXAMPLE ROUTE</div>
            <h2 id="pdHomeProductTitle">Plan the next leg.</h2>
          </div>
          <a href="/route-planner.html" class="pd-home-product-open" aria-label="Open PilotDesk Route Planner">Open planner <span aria-hidden="true">↗</span></a>
        </div>
        <div class="pd-home-product-airports" aria-label="Illustrative route from KGFK to KFAR">
          <div><span>DEPARTURE</span><strong>KGFK</strong></div>
          <svg viewBox="0 0 122 30" aria-hidden="true" focusable="false"><path d="M3 15H118" stroke="currentColor" stroke-width="1" stroke-dasharray="4 5"/><circle cx="5" cy="15" r="4" fill="#BBC4CE"/><path d="M112 9L118 15L112 21" fill="none" stroke="#BBC4CE" stroke-width="1.6"/></svg>
          <div><span>DESTINATION</span><strong>KFAR</strong></div>
        </div>
        <div class="pd-home-product-map" aria-label="Stylized route graphic. This is not an actual aviation chart or live route.">
          <div class="pd-home-product-map-head"><span>ROUTE SCHEMATIC</span><span>NOT LIVE FLIGHT DATA</span></div>
          <svg class="pd-home-route-schematic" viewBox="0 0 520 186" role="img" aria-label="Illustrative purple flight route between two waypoint circles, not a geographic chart" preserveAspectRatio="xMidYMid meet">
            <defs>
              <pattern id="pdHomeMapGrid" width="34" height="34" patternUnits="userSpaceOnUse"><path d="M34 0H0V34" fill="none" stroke="#34404B" stroke-width=".8"/></pattern>
              <linearGradient id="pdHomeMapFade" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#151D25"/><stop offset="100%" stop-color="#0B1118"/></linearGradient>
            </defs>
            <rect width="520" height="186" fill="url(#pdHomeMapFade)"/><rect width="520" height="186" fill="url(#pdHomeMapGrid)" opacity=".55"/>
            <path d="M0 143L67 132L123 152L205 125L290 137L355 100L427 112L520 75" stroke="#344451" stroke-width="1.2" fill="none"/>
            <path d="M25 10L88 64L153 54L215 90L301 50L375 57L492 25" stroke="#263540" stroke-width="1.3" stroke-dasharray="5 6" fill="none"/>
            <path class="pd-home-product-track-under" d="M102 132Q250 119 418 46" fill="none" stroke="#554778" stroke-width="7" stroke-linecap="square" opacity=".24"/>
            <path class="pd-home-product-track" d="M102 132Q250 119 418 46" fill="none" stroke="#AA92D4" stroke-width="2.6" stroke-linecap="square"/>
            <circle cx="102" cy="132" r="8" fill="#0E1520" stroke="#D8DDE3" stroke-width="2.2"/>
            <circle cx="418" cy="46" r="8" fill="#0E1520" stroke="#D8DDE3" stroke-width="2.2"/>
            <circle cx="265" cy="99" r="3.7" fill="#AA92D4" stroke="#181C26" stroke-width="2"/>
            <g fill="#EBEFF3" font-family="system-ui,sans-serif" font-size="13" font-weight="650">
              <text x="75" y="158">KGFK</text><text x="430" y="43">KFAR</text>
            </g>
            <g fill="#9DAAB6" font-family="ui-monospace,monospace" font-size="10">
              <text x="200" y="75">EXAMPLE FLIGHT PATH</text>
            </g>
          </svg>
        </div>
        <div class="pd-home-product-tools" aria-label="Route planner capabilities">
          <span>FAA CHART LAYERS</span><span>WEATHER OVERLAYS</span><span>NAVLOG</span>
        </div>
        <div class="pd-home-product-bottom"><span>Plan and review in one workspace.</span><a href="/route-planner.html">Start planning <span aria-hidden="true">→</span></a></div>
      </section>

      <div class="pd-home-proof" aria-label="PilotDesk basics">
        <span>Core tools work without an account</span><span>FAA, AWC and eCFR references</span>
      </div>
    </div>
  </section>

  <div class="pd-home-wrap">
    <section class="pd-home-desk" id="pdHomeDesk" hidden aria-labelledby="pdHomeDeskTitle">
      <div class="pd-home-desk-head">
        <div>
          <div class="eyebrow">YOUR DESK</div>
          <h2 id="pdHomeDeskTitle">Pick up where you left off</h2>
        </div>
        <span id="pdHomeDeskStatus">Saved on this device</span>
      </div>
      <div class="pd-home-desk-grid" id="pdHomeDeskItems"></div>
    </section>

    <section class="pd-home-section pd-home-crosswind" aria-labelledby="pdHomeTryToolTitle">
      <div class="pd-home-crosswind-copy">
        <div class="eyebrow">TRY A CALCULATOR</div>
        <h2 id="pdHomeTryToolTitle">Numbers you can use.</h2>
        <p>Check a crosswind component here, then open the full tool with your own runway and wind. No account needed.</p>
        <div class="pd-home-crosswind-links"><a href="/tools.html">All calculators →</a><a href="/flight-training.html">Study →</a><a href="/daily/">Daily questions →</a></div>
      </div>
      <section class="pd-home-example" aria-labelledby="home-wind-title">
        <div class="pd-home-example-head"><span class="eyebrow">CROSSWIND COMPONENT</span></div>
        <div class="pd-home-wind-heading">
          <div><h2 id="home-wind-title">Check the crosswind.</h2><p>Runway 350° · wind from 320°</p></div>
          <svg class="pd-home-wind-diagram" viewBox="0 0 112 100" role="img" aria-label="Wind from 320 degrees meets runway heading 350 degrees at a 30-degree angle">
            <circle cx="58" cy="54" r="38" class="pd-wind-ring" />
            <g transform="rotate(-10 58 54)"><rect x="53" y="20" width="10" height="68" class="pd-wind-runway" /><path d="M58 25v8m0 8v8m0 8v8m0 8v8" class="pd-wind-centerline" /></g>
            <path d="M20 9L48 42M37 38l11 4-2-12" class="pd-wind-direction" />
            <text x="81" y="23">30°</text>
          </svg>
        </div>
        <label for="pdHomeWind">Wind speed <output id="pdHomeWindValue">18 kt</output></label>
        <input id="pdHomeWind" type="range" min="0" max="40" step="1" value="18" aria-describedby="pdHomeWindNote" />
        <div class="pd-home-example-results" aria-live="polite" aria-atomic="true">
          <div><span>Crosswind from left</span><strong id="pdHomeCross">9.0 kt</strong></div>
          <div><span>Headwind</span><strong id="pdHomeHead">15.6 kt</strong></div>
        </div>
        <p id="pdHomeWindNote">30° angle · components only, not an aircraft limit.</p>
        <a id="pdHomeWindLink" href="/calculators/crosswind/?runway=350&amp;windDir=320&amp;windSpeed=18">Use your runway and wind</a>
      </section>
    </section>

    <section class="pd-home-section" id="popular-tools">
      <div class="pd-home-section-head">
        <div>
          <div class="eyebrow">TOOL INDEX</div>
          <h2>Common pilot calculations</h2>
          <p>Wind, performance, loading and fuel. Each tool includes its method and an example.</p>
        </div>
        <a href="/tools.html" data-pd-home-cta="All Calculators">Free aviation calculators →</a>
      </div>
      <div class="pd-popular-grid">
        {popularTools.map(([href, title, path]) => (
          <a class="pd-popular-tool" href={href} data-pd-home-cta={title}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span>{title}</span>
          </a>
        ))}
      </div>
      <button class="pd-home-command" id="pdHomeSearch" type="button">Search all tools <kbd>/</kbd></button>
    </section>

    <section class="pd-home-section" aria-labelledby="flight-lessons-title">
      <div class="pd-home-section-head">
        <div>
          <div class="eyebrow">PILOT MATH GUIDES</div>
          <h2 id="flight-lessons-title">Guides to common flight calculations</h2>
          <p>Read the method, then try your own values in the related calculator.</p>
        </div>
        <a href="/guides.html">Browse aviation guides →</a>
      </div>
      <div class="pd-home-lessons">
        <a href="/guides/crosswind-component.html"><b>Crosswind components</b><span>Resolve reported wind against a runway heading.</span><em>Crosswind guide →</em></a>
        <a href="/guides/density-altitude.html"><b>Density altitude</b><span>Estimate density altitude from pressure altitude and temperature.</span><em>Density-altitude guide →</em></a>
        <a href="/guides/wind-triangle.html"><b>Wind triangle</b><span>Find the heading and groundspeed for a course and wind.</span><em>Wind-triangle guide →</em></a>
      </div>
    </section>

    <section class="pd-home-section pd-home-route" aria-labelledby="route-title">
      <div>
        <div class="eyebrow">ROUTE PLANNING</div>
        <h2 id="route-title">Build the route. Review each leg.</h2>
        <p>Find airports and fixes, plot on FAA charts, and calculate a navlog using your aircraft and wind inputs.</p>
        <div class="pd-actions"><a class="pd-btn" href="/route-planner.html">Open Route Planner</a><a href="/aircraft.html">Your aircraft →</a></div>
      </div>
      <ol class="pd-home-route-steps">
        <li><b>Enter waypoints</b><span>Airport identifiers, navigation fixes or coordinates.</span></li>
        <li><b>Run the numbers</b><span>Distance, course, heading, time and fuel by leg.</span></li>
        <li><b>Check the context</b><span>FAA chart layers, endpoint weather and procedure links.</span></li>
      </ol>
    </section>

    <section class="pd-home-section pd-home-learn" aria-labelledby="learn-title">
      <div class="pd-home-section-head"><div><div class="eyebrow">LEARN</div><h2 id="learn-title">Study for the flying you do.</h2><p>FAA references, oral practice and tools connected to each subject.</p></div><a href="/flight-training.html">Open Learn →</a></div>
      <div class="pd-home-ratings">
        <a href="/training/private-pilot.html">Private</a><a href="/training/instrument-rating.html">Instrument</a><a href="/training/commercial-pilot.html">Commercial</a><a href="/training/multiengine.html">Multi-engine</a><a href="/training/cfi.html">CFI</a><a href="/training/cfii.html">CFII</a>
      </div>
      <div class="pd-home-study-links"><a href="/written-prep.html">Written prep →</a><a href="/learn/oral-exam/">Oral exam guide →</a><a href="/daily/">Three daily questions →</a></div>
    </section>

    <section class="pd-home-section pd-home-weather" aria-labelledby="weather-title">
      <div><div class="eyebrow">AIRPORT WEATHER</div><h2 id="weather-title">Read the report. Check the time.</h2><p>Look up METARs and TAFs with the raw report, decoded conditions, and observation or issue time kept together.</p></div>
      <div class="pd-home-weather-links"><a href="/weather.html"><b>Check an airport</b><span>Current reports and runway-wind context →</span></a><a href="/guides/metar-taf.html"><b>Practice the decode</b><span>Wind, ceilings and forecast change groups →</span></a></div>
    </section>

    <section class="pd-home-section pd-home-account" data-pd-home-account aria-label="PilotDesk account">
      <div>
        <div class="eyebrow">OPTIONAL ACCOUNT</div>
        <h2 data-pd-home-account-title>Sign in when you want progress saved.</h2>
        <p data-pd-home-account-copy>Free accounts save Daily, Written Prep, and profile progress. Pro adds aircraft and saved-flight cloud backup plus an ad-free signed-in experience.</p>
      </div>
      <div class="pd-home-business-actions" data-pd-home-account-actions>
        <a class="pd-btn secondary" href="/account.html?next=%2F" data-pd-home-cta="Create Account">Create a free account</a>
        <a href="/account.html?next=%2F" data-pd-home-cta="Sign In">Sign in →</a>
      </div>
    </section>

    <section class="pd-home-section pd-home-trust">
      <div>
        <div class="eyebrow">SOURCES</div>
        <h2>FAA, weather and aircraft references</h2>
        <p>For a flight, use current FAA charts and regulations, official weather reports, and the aircraft’s POH/AFM.</p>
      </div>
      <a href="/sources.html">Sources & methods →</a>
    </section>

    <section class="pd-home-section pd-home-faq" aria-labelledby="faq-title">
      <div class="pd-home-section-head">
        <div><h2 id="faq-title">Common questions</h2></div>
      </div>
      <div class="pd-faq-list">
        <details><summary>What is PilotDesk?</summary><p>A browser-based set of aviation calculators, route-planning, weather, and study tools.</p></details>
        <details><summary>Do I need an account?</summary><p>No. Core tools work without one. A free account saves Daily, Written Prep, and profile progress. Pro adds aircraft and saved-flight cloud backup.</p></details>
        <details><summary>Are calculator results official operational data?</summary><p>No. Use PilotDesk as a planning aid and verify operational decisions with current approved aircraft, airport, weather, procedural, and regulatory sources.</p></details>
        <details><summary>What is PilotDesk Daily?</summary><p>A three-question aviation challenge that changes every day.</p></details>
      </div>
    </section>
  </div>
  <script slot="scripts" is:inline defer src="/assets/home-desk.js"></script>
</BaseLayout>
