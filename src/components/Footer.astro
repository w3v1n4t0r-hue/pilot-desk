---
import { footerLinks } from '../data/site.mjs';
---
<footer>
  <div>
    <b>PilotDesk</b>
    <p>Planning and training tools for pilots.</p>
  </div>
  <div class="footer-links">
    {footerLinks.map(([href, label]) => <a href={href}>{label}</a>)}
  </div>
  <p class="fine">PilotDesk supplements—not replaces—current official weather, charts, NOTAMs, regulations, procedures, and approved aircraft data.</p>
</footer>
