---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePlans from '../components/HomePlans.astro';
import { popularTools } from '../data/site.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      description: 'Free aviation calculators, route planning, airport weather, and FAA-based study tools, with optional Pro checkride practice and advanced route review.'
    },
    {
      '@type': 'Organization',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      logo: { '@type': 'ImageObject', url: 'https://www.pilot-desk.com/favicon.svg' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What is PilotDesk?', 'PilotDesk is a browser-based set of aviation calculators, route-planning, weather, and study tools.'],
        ['Do I need an account?', 'No. Core tools work without an account. A free account saves Daily, Written Prep, and profile progress. PilotDesk Pro adds full Checkride Lab, study planning, advanced route review, unlimited aircraft and saved flights, manual cloud backup, and ad-free signed-in use.'],
        ['What can I calculate with PilotDesk?', 'Calculate wind components, altitude, fuel, time, distance, and aircraft loading.'],
        ['What is PilotDesk Daily?', 'PilotDesk Daily is a short aviation challenge with three new questions each day.']
      ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
    }
  ]
};
---
<BaseLayout
  title="Flight Planning, FAA Charts & Aviation Tools | PilotDesk"
  description="Start on the sectional chart. Plan a route, check airport weather and procedures, and work through flight calculations with PilotDesk."
  canonical="/" schema={schema} bodyClass="pd-home-chart"
>
  <link slot="head" rel="stylesheet" href="/assets/home-desk.css" />
  <link slot="head" rel="preload" as="image" href="/assets/chart-overviews/sectional.webp" fetchpriority="high" />
  <h1 class="pd-home-sr">Plan a flight with PilotDesk</h1>
  <section class="pd-chart-entry" id="home-chart" aria-label="Interactive sectional chart">
    <div class="pd-chart-window">
      <iframe id="pdHomeChart" title="FAA sectional chart and route planner" src="/route-planner.html?embed=home#map=-98/39/5/sectional" loading="eager" allow="fullscreen" allowfullscreen></iframe>
    </div>
    <div class="pd-chart-foot">
      <span id="pdHomeChartStatus" role="status">Opening sectional chart…</span>
      <button id="pdHomeGestures" type="button" aria-pressed="false" hidden>Explore chart</button>
      <a href="/route-planner.html" data-home-planner>Open route planner ↗</a>
    </div>
  </section>
  <nav class="pd-route-passport" aria-label="Your flight planning workspace">
    <a class="pd-passport-route" href="/route-planner.html" data-home-planner><span class="eyebrow">YOUR ROUTE</span><strong id="pdHomeRouteContext">Start on the chart</strong></a>
    <div><a href="#flight-workflow">Flight planning</a><a href="#popular-tools">Calculators</a><a href="#home-study">Study</a><a href="#home-route">Plan a flight ↓</a></div>
  </nav>
  <div class="pd-chart-content" id="pdHomeStory">
    <section class="pd-flight-workflow" id="flight-workflow" data-sc-act="flow" aria-labelledby="workflow-title">
      <div class="pd-home-section-copy">
        <div class="eyebrow">FLIGHT PLANNING</div>
        <h2 id="workflow-title">One route.<br />The details around it.</h2>
        <p>Chart the route, check the airports, then work through the numbers. Keep the next step close.</p>
        <a class="pd-btn" href="/route-planner.html" data-home-planner>Open route planner</a>
      </div>
      <div class="pd-workflow-path">
        <svg class="pd-route-line" viewBox="0 0 480 280" aria-hidden="true" data-sc-parallax="-.25"><path d="M40 230L160 60L290 170L430 35"/><circle cx="40" cy="230" r="8"/><circle cx="160" cy="60" r="8"/><circle cx="290" cy="170" r="8"/><circle cx="430" cy="35" r="8"/></svg>
        <a href="/route-planner.html" data-home-planner><span>ROUTE + NAVLOG</span><b>Where are you flying? ↗</b></a>
        <a href="/weather.html"><span>WEATHER</span><b>METARs, TAFs, and runway winds ↗</b></a>
        <a href="/airport.html"><span>AIRPORTS</span><b>Frequencies, runways, procedures ↗</b></a>
        <a href="/aircraft.html"><span>AIRCRAFT</span><b>Your aircraft. Your planning values. ↗</b></a>
      </div>
    </section>
    <section class="pd-home-desk" id="pdHomeDesk" hidden aria-labelledby="pdHomeDeskTitle">
      <div class="pd-home-desk-head">
        <div>
          <div class="eyebrow">YOUR DESK</div>
          <h2 id="pdHomeDeskTitle">Pick up where you left off</h2>
        </div>
        <span id="pdHomeDeskStatus">Saved on this device</span>
      </div>
      <div class="pd-home-desk-grid" id="pdHomeDeskItems"></div>
    </section>


    <section class="pd-home-crosswind pd-chart-calculation" data-sc-act="flow" aria-labelledby="pdHomeTryToolTitle">
      <div class="pd-home-section-copy"><div class="eyebrow">WORK THROUGH THE NUMBERS</div><h2 id="pdHomeTryToolTitle">Wind changes.<br />See the difference.</h2><p>Move the wind speed. See what changes across the runway and along it.</p><a href="/calculators/crosswind/">Use your runway and wind →</a></div>
      <section class="pd-home-example" aria-labelledby="home-wind-title">
        <div class="pd-home-example-head"><span class="eyebrow">Runway wind</span></div>
        <div class="pd-home-wind-heading">
          <div><h2 id="home-wind-title">Crosswind component</h2><p>Runway 350° · wind from 320°</p></div>
          <svg class="pd-home-wind-diagram" data-sc-reveal="up" data-sc-reveal-at="0 .3" viewBox="0 0 112 100" role="img" aria-label="Wind from 320 degrees meets runway heading 350 degrees at a 30-degree angle">
            <circle cx="58" cy="54" r="38" class="pd-wind-ring" />
            <g transform="rotate(-10 58 54)"><rect x="53" y="20" width="10" height="68" class="pd-wind-runway" /><path d="M58 25v8m0 8v8m0 8v8m0 8v8" class="pd-wind-centerline" /></g>
            <path data-pd-wind-vector d="M20 9L48 42M37 38l11 4-2-12" class="pd-wind-direction" />
            <text x="81" y="23">30°</text>
          </svg>
        </div>
        <label for="pdHomeWind">Wind speed <output id="pdHomeWindValue">18 kt</output></label>
        <input id="pdHomeWind" type="range" min="0" max="40" step="1" value="18" aria-describedby="pdHomeWindNote" />
        <div class="pd-home-example-results" aria-live="polite" aria-atomic="true">
          <div><span>Crosswind from left</span><strong id="pdHomeCross">9.0 kt</strong></div>
          <div><span>Headwind</span><strong id="pdHomeHead">15.6 kt</strong></div>
        </div>
        <p id="pdHomeWindNote">30° angle · components only, not an aircraft limit.</p>
        <a id="pdHomeWindLink" href="/calculators/crosswind/?runway=350&amp;windDir=320&amp;windSpeed=18">Use your runway and wind</a>
        <div class="pd-home-study-links"><a href="/guides/crosswind-component.html">See the calculation →</a><a href="/learn/oral-exam/">Practice explaining it →</a></div>
      </section>
    </section>
    <section id="popular-tools" class="pd-chart-tools" aria-labelledby="tools-title">
      <div data-sc-in><div class="eyebrow">CALCULATORS</div><h2 id="tools-title">A quick answer.<br />The math behind it.</h2><p>Wind, altitude, fuel, time, and aircraft loading.</p></div>
      <div class="pd-popular-grid" data-sc-in data-sc-stagger="40">{popularTools.map(([href, title, path]) => (<a class="pd-popular-tool" href={href}><svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span>{title}</span><span aria-hidden="true">↗</span></a>))}</div>
      <div class="pd-chart-links"><a href="/tools.html">Free aviation calculators →</a><button id="pdHomeSearch" type="button">Search all tools <kbd>/</kbd></button><a href="/e6b-flight-computer.html">Open E6B →</a></div>
    </section>
    <section class="pd-chart-study" id="home-study" aria-labelledby="learn-title">
      <div class="pd-home-section-copy"><div class="eyebrow">STUDY</div><h2 id="learn-title">Know the answer.<br />Practice explaining it.</h2><p>Work through a subject, check your reasoning, and return to what needs another look.</p><a href="/flight-training.html">Study →</a></div>
      <div class="pd-study-list"><a href="/written-prep.html"><b>Written prep</b><span>Practice questions and explanations ↗</span></a><a href="/learn/oral-exam/"><b>Oral exam practice</b><span>Answer in your own words ↗</span></a><a href="/daily/"><b>Three daily questions →</b><span>A short review, every day ↗</span></a><a href="/guides.html"><b>Pilot guides</b><span>Read the method behind the calculation ↗</span></a></div>
    </section>
    <section class="pd-chart-start" id="home-route" aria-labelledby="pdHomeProductTitle">
      <div><div class="eyebrow">YOUR NEXT FLIGHT</div><h2 id="pdHomeProductTitle">Where are you flying?</h2><p>Enter your departure and destination. Add the details on the chart.</p></div>
      <form class="pd-home-route-form" action="/route-planner.html" method="get" autocomplete="off" aria-label="Start a route">
        <div class="pd-home-route-fields"><label for="pdHomeDeparture">Departure airport<input id="pdHomeDeparture" name="from" autocapitalize="characters" spellcheck="false" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" placeholder="KGFK" required /></label><label for="pdHomeDestination">Destination airport<input id="pdHomeDestination" name="to" autocapitalize="characters" spellcheck="false" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" placeholder="KFAR" required /></label></div>
        <button class="pd-btn" type="submit">Open route planner →</button>
        <div class="pd-chart-links"><a href="/flights.html">Saved flights ↗</a><a href="/aircraft.html">My aircraft ↗</a></div>
      </form>
    </section>
    <section class="pd-chart-account" data-pd-home-account aria-label="PilotDesk account">
      <div><div class="eyebrow">Your account</div><h2 data-pd-home-account-title>Keep your progress.</h2><p data-pd-home-account-copy>Keep missed questions, Daily history, and your training goal with your free account.</p></div>
      <div class="pd-chart-links" data-pd-home-account-actions><a class="pd-btn secondary" href="/account.html?next=%2F">Create a free account</a><a href="/account.html?next=%2F">Sign in →</a></div>
    </section>
    <HomePlans />
    <section data-pd-reveal class="pd-home-section pd-home-faq" aria-labelledby="faq-title">
      <div class="pd-home-section-head">
        <div><h2 id="faq-title">Common questions</h2></div>
      </div>
      <div class="pd-faq-list">
        <details><summary>What is PilotDesk?</summary><p>A browser-based set of aviation calculators, route-planning, weather, and study tools.</p></details>
        <details><summary>Do I need an account?</summary><p>No. Core tools work without one. A free account saves Daily, Written Prep, and profile progress. Pro adds full Checkride Lab, study planning, advanced route review, unlimited aircraft and saved flights, manual cloud backup, and ad-free signed-in use. <a href="/pricing.html">Compare plans.</a></p></details>
        <details><summary>Are calculator results official operational data?</summary><p>No. Use PilotDesk as a planning aid and verify operational decisions with current approved aircraft, airport, weather, procedural, and regulatory sources.</p></details>
        <details><summary>What is PilotDesk Daily?</summary><p>A three-question aviation challenge that changes every day.</p></details>
      </div>
    </section>

    <div class="pd-chart-sources"><span class="eyebrow">SOURCES</span><a href="/sources.html">Sources & methods →</a><a href="/pricing.html">Free & Pro →</a></div>
  </div>
  <script slot="scripts" is:inline defer src="/assets/home-desk.js"></script>
  <script slot="scripts" is:inline defer src="/assets/home-chart.js"></script>
</BaseLayout>
