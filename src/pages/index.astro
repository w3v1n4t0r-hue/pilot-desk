---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePlans from '../components/HomePlans.astro';
import { popularTools } from '../data/site.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      description: 'Free aviation calculators, route planning, airport weather, and FAA-based study tools, with optional Pro checkride practice and advanced route review.'
    },
    {
      '@type': 'Organization',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      logo: { '@type': 'ImageObject', url: 'https://www.pilot-desk.com/favicon.svg' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What is PilotDesk?', 'PilotDesk is a browser-based set of aviation calculators, route-planning, weather, and study tools.'],
        ['Do I need an account?', 'No. Core tools work without an account. A free account saves Daily, Written Prep, and profile progress. PilotDesk Pro adds full Checkride Lab, study planning, advanced route review, unlimited aircraft and saved flights, manual cloud backup, and ad-free signed-in use.'],
        ['What can I calculate with PilotDesk?', 'Calculate wind components, altitude, fuel, time, distance, and aircraft loading.'],
        ['What is PilotDesk Daily?', 'PilotDesk Daily is a short aviation challenge with three new questions each day.']
      ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
    }
  ]
};
---
<BaseLayout
  title="Free Aviation Calculators, Flight Planning & Training | PilotDesk"
  description="Free aviation calculators, flight planning, weather, written prep, and checkride study tools for student pilots, instrument pilots, commercial pilots, and CFIs."
  canonical="/"
  schema={schema}
  bodyClass="pd-home-2026"
>
  <link slot="head" rel="stylesheet" href="/assets/home-desk.css" />
    <section class="pd-home-desk" id="pdHomeDesk" hidden aria-labelledby="pdHomeDeskTitle">
      <div class="pd-home-desk-head">
        <div>
          <div class="eyebrow">YOUR DESK</div>
          <h2 id="pdHomeDeskTitle">Pick up where you left off</h2>
        </div>
        <span id="pdHomeDeskStatus">Saved on this device</span>
      </div>
      <div class="pd-home-desk-grid" id="pdHomeDeskItems"></div>
    </section>

  <section class="pd-home-hero" aria-labelledby="pdHomeTitle">
    <div class="pd-home-hero-inner">
      <div class="pd-home-hero-copy">
        <div class="eyebrow">Plan, calculate, and study</div>
        <h1 id="pdHomeTitle">Plan the flight.<span>Understand the numbers.</span></h1>
        <p>Flight planning, aviation calculators, weather, and checkride practice in your browser. Work through the numbers and the reasoning behind them.</p>
        <nav class="pd-home-hero-links" aria-label="Start a pilot task">
          <a class="pd-btn" href="/route-planner.html" data-pd-home-cta="Start Planning">Plan a flight</a>
          <a class="pd-home-command" href="/learn/oral-exam/" data-pd-home-cta="Checkride Practice">Practice for a checkride <span aria-hidden="true">↗</span></a>
          <a class="pd-home-command" href="/weather.html" data-pd-home-cta="Weather">Check weather <span aria-hidden="true">↗</span></a>
          <a class="pd-home-command" href="/tools.html" data-pd-home-cta="Browse Tools">Open tools <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <section data-pd-preview class="pd-home-product" aria-labelledby="pdHomeProductTitle">
        <div class="pd-home-product-body">
          <h2 id="pdHomeProductTitle">Where are you flying?</h2>
          <p>Start with your departure and destination.</p>
          <form class="pd-home-route-form" action="/route-planner.html" method="get" autocomplete="off" aria-label="Start a route">
            <div class="pd-home-route-fields">
              <label for="pdHomeDeparture">Departure airport
                <input id="pdHomeDeparture" name="from" type="text" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" placeholder="e.g. KGFK" required />
              </label>
              <label for="pdHomeDestination">Destination airport
                <input id="pdHomeDestination" name="to" type="text" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" placeholder="e.g. KFAR" required />
              </label>
            </div>
            <button type="submit" class="pd-btn pd-home-route-submit">Open route planner <span aria-hidden="true">→</span></button>
          </form>
        </div>
        <div class="pd-home-product-bottom">
          <a href="/flights.html">Saved flights <span aria-hidden="true">↗</span></a>
          <a href="/aircraft.html">My aircraft <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <div class="pd-home-proof" aria-label="PilotDesk basics">
        <span>Free calculators · no account needed</span><span>FAA charts · AWC weather</span>
      </div>
    </div>
  </section>

  <div class="pd-home-wrap">
    <section data-pd-reveal class="pd-home-section" id="popular-tools">
      <div class="pd-home-section-head">
        <div>
          <div class="eyebrow">Calculators</div>
          <h2>The tools you reach for.</h2>
          <p>Wind, altitude, fuel and weight & balance.</p>
        </div>
        <a href="/tools.html" data-pd-home-cta="All Calculators">Free aviation calculators →</a>
      </div>
      <div class="pd-popular-grid">
        {popularTools.map(([href, title, path]) => (
          <a data-pd-hover class="pd-popular-tool" href={href} data-pd-home-cta={title}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span>{title}</span>
          </a>
        ))}
      </div>
      <button class="pd-home-command" id="pdHomeSearch" type="button">Search all tools <kbd>/</kbd></button>
    </section>

    <section data-pd-reveal class="pd-home-section pd-home-crosswind" aria-labelledby="pdHomeTryToolTitle">
      <div class="pd-home-crosswind-copy">
        <div class="eyebrow">Crosswind</div>
        <h2 id="pdHomeTryToolTitle">Wind changes.<br />See the difference.</h2>
        <p>Move the wind-speed slider. Watch the crosswind and headwind change.</p>
        <div class="pd-home-crosswind-links"><a href="/tools.html">All calculators →</a><a href="/flight-training.html">Study →</a><a href="/daily/">Daily questions →</a></div>
      </div>
      <section class="pd-home-example" aria-labelledby="home-wind-title">
        <div class="pd-home-example-head"><span class="eyebrow">Runway wind</span></div>
        <div class="pd-home-wind-heading">
          <div><h2 id="home-wind-title">Crosswind component</h2><p>Runway 350° · wind from 320°</p></div>
          <svg class="pd-home-wind-diagram" viewBox="0 0 112 100" role="img" aria-label="Wind from 320 degrees meets runway heading 350 degrees at a 30-degree angle">
            <circle cx="58" cy="54" r="38" class="pd-wind-ring" />
            <g transform="rotate(-10 58 54)"><rect x="53" y="20" width="10" height="68" class="pd-wind-runway" /><path d="M58 25v8m0 8v8m0 8v8m0 8v8" class="pd-wind-centerline" /></g>
            <path data-pd-wind-vector d="M20 9L48 42M37 38l11 4-2-12" class="pd-wind-direction" />
            <text x="81" y="23">30°</text>
          </svg>
        </div>
        <label for="pdHomeWind">Wind speed <output id="pdHomeWindValue">18 kt</output></label>
        <input id="pdHomeWind" type="range" min="0" max="40" step="1" value="18" aria-describedby="pdHomeWindNote" />
        <div class="pd-home-example-results" aria-live="polite" aria-atomic="true">
          <div><span>Crosswind from left</span><strong id="pdHomeCross">9.0 kt</strong></div>
          <div><span>Headwind</span><strong id="pdHomeHead">15.6 kt</strong></div>
        </div>
        <p id="pdHomeWindNote">30° angle · components only, not an aircraft limit.</p>
        <a id="pdHomeWindLink" href="/calculators/crosswind/?runway=350&amp;windDir=320&amp;windSpeed=18">Use your runway and wind</a>
        <div class="pd-home-study-links"><a href="/guides/crosswind-component.html">See the calculation →</a><a href="/learn/oral-exam/">Practice explaining it →</a></div>
      </section>
    </section>

    <section data-pd-reveal class="pd-home-section" aria-labelledby="flight-lessons-title">
      <div class="pd-home-section-head">
        <div>
          <div class="eyebrow">Pilot guides</div>
          <h2 id="flight-lessons-title">Know what the numbers mean.</h2>
          <p>Check the calculation, read the explanation, and practice a related subject.</p>
        </div>
        <a href="/guides.html">Browse aviation guides →</a>
      </div>
      <div class="pd-home-lessons">
        <a href="/guides/crosswind-component.html"><b>Crosswind components</b><span>Resolve reported wind against a runway heading.</span><em>Crosswind guide →</em></a>
        <a href="/guides/density-altitude.html"><b>Density altitude</b><span>Estimate density altitude from pressure altitude and temperature.</span><em>Density-altitude guide →</em></a>
        <a href="/guides/wind-triangle.html"><b>Wind triangle</b><span>Find the heading and groundspeed for a course and wind.</span><em>Wind-triangle guide →</em></a>
      </div>
    </section>

    <section data-pd-reveal class="pd-home-section pd-home-route" aria-labelledby="route-title">
      <div>
        <div class="eyebrow">Flight planning</div>
        <h2 id="route-title">Your route, on FAA charts.</h2>
        <p>Find airports and fixes, plot on FAA charts, and build a flight log with heading, time, and fuel for each leg.</p>
        <div class="pd-actions"><a class="pd-btn" href="/route-planner.html">Open Route Planner</a><a href="/aircraft.html">Your aircraft →</a></div>
      </div>
      <ol class="pd-home-route-steps">
        <li><b>Enter waypoints</b><span>Airport identifiers, navigation fixes or coordinates.</span></li>
        <li><b>Run the numbers</b><span>Distance, course, heading, time and fuel by leg.</span></li>
        <li><b>Review weather & procedures</b><span>Charts, airport weather and published procedures.</span></li>
      </ol>
    </section>

    <section data-pd-reveal class="pd-home-section pd-home-learn" aria-labelledby="learn-title">
      <div class="pd-home-section-head"><div><div class="eyebrow">LEARN</div><h2 id="learn-title">You recognize the answer. Can you explain it?</h2><p>Practice answering oral questions in your own words, work through follow-ups, and find subjects to revisit before your next ground lesson.</p></div><a href="/flight-training.html">Open Learn →</a></div>
      <div class="pd-home-ratings">
        <a href="/training/private-pilot.html">Private</a><a href="/training/instrument-rating.html">Instrument</a><a href="/training/commercial-pilot.html">Commercial</a><a href="/training/multiengine.html">Multi-engine</a><a href="/training/cfi.html">CFI</a><a href="/training/cfii.html">CFII</a>
      </div>
      <div class="pd-actions pd-home-study-actions"><a class="pd-btn secondary" href="/learn/checkride-lab/">View Checkride Lab · Pro</a><a href="/learn/oral-exam/">Try free oral subjects →</a></div>
      <details class="pd-home-lab-method"><summary>How Checkride Lab reviews your answer</summary><p>Typed responses are checked against listed study topics locally in your browser. Choose a focused drill or a mock oral with feedback at the end. The topic check can flag subjects to revisit; it does not judge your answer like an examiner or establish checkride readiness.</p></details>
      <div class="pd-home-study-links"><a href="/written-prep.html">Written prep →</a><a href="/learn/oral-exam/">Oral exam guide →</a><a href="/daily/">Three daily questions →</a></div>
    </section>

    <section data-pd-reveal class="pd-home-section pd-home-weather" aria-labelledby="weather-title">
      <div><div class="eyebrow">Weather</div><h2 id="weather-title">METARs and TAFs.</h2><p>Find airport weather, read the report and check when it was issued.</p></div>
      <div class="pd-home-weather-links"><a href="/weather.html"><b>Check an airport</b><span>Current reports and runway-wind context →</span></a><a href="/guides/metar-taf.html"><b>Learn to read METARs</b><span>Wind, ceilings and forecast change groups →</span></a></div>
    </section>

    <HomePlans />

    <section data-pd-reveal class="pd-home-section pd-home-account" data-pd-home-account aria-label="PilotDesk account">
      <div>
        <div class="eyebrow">Your account</div>
        <h2 data-pd-home-account-title>Keep your progress.</h2>
        <p data-pd-home-account-copy>Keep missed questions, Daily history, and your training goal with your free account. Return to the subjects you need to revisit.</p>
      </div>
      <div class="pd-home-business-actions" data-pd-home-account-actions>
        <a class="pd-btn secondary" href="/account.html?next=%2F" data-pd-home-cta="Create Account">Create a free account</a>
        <a href="/account.html?next=%2F" data-pd-home-cta="Sign In">Sign in →</a>
      </div>
    </section>

    <section data-pd-reveal class="pd-home-section pd-home-trust">
      <div>
        <div class="eyebrow">SOURCES</div>
        <h2>See the method. Check the source.</h2>
        <p>Calculator explanations identify methods and assumptions; study material links to FAA references. For a flight, verify information with current official sources and your aircraft’s approved POH/AFM.</p>
      </div>
      <a href="/sources.html">Sources & methods →</a>
    </section>

    <section data-pd-reveal class="pd-home-section pd-home-faq" aria-labelledby="faq-title">
      <div class="pd-home-section-head">
        <div><h2 id="faq-title">Common questions</h2></div>
      </div>
      <div class="pd-faq-list">
        <details><summary>What is PilotDesk?</summary><p>A browser-based set of aviation calculators, route-planning, weather, and study tools.</p></details>
        <details><summary>Do I need an account?</summary><p>No. Core tools work without one. A free account saves Daily, Written Prep, and profile progress. Pro adds full Checkride Lab, study planning, advanced route review, unlimited aircraft and saved flights, manual cloud backup, and ad-free signed-in use. <a href="/pricing.html">Compare plans.</a></p></details>
        <details><summary>Are calculator results official operational data?</summary><p>No. Use PilotDesk as a planning aid and verify operational decisions with current approved aircraft, airport, weather, procedural, and regulatory sources.</p></details>
        <details><summary>What is PilotDesk Daily?</summary><p>A three-question aviation challenge that changes every day.</p></details>
      </div>
    </section>
  </div>
  <script slot="scripts" is:inline defer src="/assets/home-desk.js"></script>
  <script>import "../scripts/design-motion.js";</script>
</BaseLayout>
