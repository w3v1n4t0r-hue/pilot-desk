<!-- PilotDesk's live-surface adaptation of nateherkai/scroll-craft. No fake flight data. -->
<div class="pd-sc-story" id="pdScrollStory" aria-label="How PilotDesk fits into a flight">
  <section class="pd-sc-opening" data-sc-act="flow" aria-labelledby="pdScStartTitle">
    <div class="pd-sc-opening-copy">
      <span class="pd-sc-overline">From the route to the numbers</span>
      <h2 id="pdScStartTitle">Start planning. Keep the details together.</h2>
      <p>Enter your route, work through the flight math, then review weather and source material. You can do the core work without creating an account.</p>
    </div>
    <div class="pd-sc-opening-ref" aria-hidden="true"><span>ROUTE</span><span>CALCULATION</span><span>REVIEW</span></div>
  </section>

  <section class="pd-sc-flight" data-sc-act="pin" data-sc-span="1.35" aria-labelledby="pdScFlightTitle">
    <div class="pd-sc-stage" data-sc-stage>
      <div class="pd-sc-grid" data-sc-parallax="-0.06" aria-hidden="true"></div>
      <div class="pd-sc-stage-top">
        <span class="pd-sc-overline">FLIGHT WORKFLOW / VISUAL GUIDE</span>
        <span class="pd-sc-note">Planning sequence, not a navigation chart</span>
      </div>
      <div class="pd-sc-stage-title">
        <h2 id="pdScFlightTitle">A route is only the beginning.</h2>
        <p>Work through the parts of a cross-country plan in the order that makes sense for the flight.</p>
      </div>
      <div class="pd-sc-track" aria-hidden="true">
        <div class="pd-sc-route-line"></div>
        <div class="pd-sc-route-progress"></div>
        <div class="pd-sc-plane">
          <svg viewBox="0 0 104 56" focusable="false">
            <path d="M93 28L62 28 42 5 34 5 42 28 18 28 10 18 4 18 8 28 4 38 10 38 18 28 42 28 34 51 42 51 62 28Z" />
            <path d="M18 28H93" />
          </svg>
        </div>
        <div class="pd-sc-station pd-sc-station-a"><span></span><small>ROUTE</small></div>
        <div class="pd-sc-station pd-sc-station-b"><span></span><small>NUMBERS</small></div>
        <div class="pd-sc-station pd-sc-station-c"><span></span><small>CONDITIONS</small></div>
      </div>
      <div class="pd-sc-workflows">
        <div><span>01 / PLAN</span><h3>Put the route on the chart.</h3><p>Find airports and fixes, then build the legs of the flight.</p><a href="/route-planner.html">Open the route planner →</a></div>
        <div><span>02 / CALCULATE</span><h3>Check the math.</h3><p>Work out wind correction, groundspeed, time and estimated fuel.</p><a href="/e6b-flight-computer.html">Use the E6B →</a></div>
        <div><span>03 / VERIFY</span><h3>Review the conditions.</h3><p>Look at airport weather and advisories. Confirm the flight with current official sources.</p><a href="/weather.html">Check weather →</a></div>
      </div>
    </div>
  </section>

  <section class="pd-sc-outro" data-sc-act="flow" aria-labelledby="pdScOutroTitle">
    <div>
      <span class="pd-sc-overline">TRY THE MATH</span>
      <h2 id="pdScOutroTitle">See what a change in wind does.</h2>
      <p>Move the wind-speed slider below and compare the crosswind with the headwind. The numbers update as you move it.</p>
    </div>
    <a href="/calculators/crosswind/">Open the full crosswind calculator →</a>
  </section>
</div>