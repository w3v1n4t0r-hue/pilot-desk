---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeActions, popularTools, homeCategories } from '../data/site.mjs';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      description: 'Free aviation calculators, flight planning, weather tools, and pilot training.'
    },
    {
      '@type': 'Organization',
      name: 'PilotDesk',
      url: 'https://www.pilot-desk.com/',
      logo: { '@type': 'ImageObject', url: 'https://www.pilot-desk.com/assets/icon.svg' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What aviation tools does PilotDesk include?', 'PilotDesk brings together flight planning, aviation calculators, weather references, aircraft performance tools, and pilot study resources.'],
        ['Are PilotDesk calculator results official operational data?', 'No. Results are planning aids based on the inputs and methods shown on each tool. Verify operational decisions with current approved aircraft, airport, weather, and regulatory sources.'],
        ['Can I use PilotDesk for FAA written test preparation?', 'Yes. PilotDesk includes rating-focused practice for common FAA written-test subjects, with explanations and weak-area review.']
      ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
    }
  ]
};
---
<BaseLayout
  title="PilotDesk | Flight Planning, Aviation Calculators & Pilot Training"
  description="Plan flights, run aviation calculations, check weather, study FAA written-test subjects, and play PilotDesk Daily."
  canonical="/"
  schema={schema}
  bodyClass="pd-home-2026"
>
  <section class="pd-home-hero" aria-labelledby="pdHomeTitle">
    <div class="pd-home-hero-inner">
      <div class="pd-home-hero-copy">
        <div class="eyebrow">PLAN · CALCULATE · LEARN · FLY</div>
        <h1 id="pdHomeTitle">Built for the next leg.</h1>
        <p>Flight planning, pilot math, weather, and written prep in one place. Pick what you need and get to it.</p>
      </div>
      <div class="pd-home-actions">
        {homeActions.slice(0,3).map(([href, title, copy, path], index) => (
          <a class="pd-home-action" href={href} data-pd-launch={index === 2 ? 'written-prep' : undefined}>
            <span class="pd-home-action-icon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg></span>
            <b>{title}</b><span>{copy}</span><em aria-hidden="true">›</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="pd-home-wrap">
    <section class="pd-home-section" aria-labelledby="pdHomeProofTitle">
      <div class="pd-home-section-head">
        <div><div class="eyebrow">ONE WORKSPACE · CLEAR NEXT STEP</div><h2 id="pdHomeProofTitle">From first number to final cross-check.</h2><p>Keep planning, calculations, weather context, and training close without turning the screen into a cockpit imitation.</p></div>
      </div>
      <div class="pd-home-proof" aria-label="PilotDesk planning workspace preview">
        <div class="pd-home-proof-main">
          <div class="eyebrow">ROUTE · SAMPLE</div><h3>KMSN → KOSH</h3><p class="fine">A restrained planning view keeps the route readable and the source context close.</p>
          <svg viewBox="0 0 420 190" aria-hidden="true"><path d="M18 154C92 142 122 70 196 94s105-52 206-61"/><path class="pd-route-line" d="M18 154 196 94 402 33"/><circle cx="18" cy="154" r="5"/><circle cx="196" cy="94" r="5"/><circle cx="402" cy="33" r="5"/></svg>
        </div>
        <div class="pd-home-proof-side">
          <div class="eyebrow">PLANNING SNAPSHOT</div><h3>Useful numbers, not decoration.</h3>
          <div class="pd-home-proof-kpis"><div><strong>243°</strong><span>True course</span></div><div><strong>01:08</strong><span>Estimated time</span></div><div><strong>8.6 gal</strong><span>Trip fuel</span></div><div><strong>12 kt</strong><span>Crosswind</span></div></div>
        </div>
      </div>
    </section>

    <section class="pd-home-section pd-learning-promo" data-pd-home-account aria-label="PilotDesk account">
      <div>
        <div class="eyebrow">YOUR PILOTDESK</div>
        <h2 data-pd-home-account-title>Sign in to save your progress</h2>
        <p data-pd-home-account-copy>Keep written-prep scores, streaks, aircraft, and other PilotDesk progress tied to your account.</p>
        <div class="pd-actions" data-pd-home-account-actions>
          <a class="pd-btn" href="/account.html?next=%2F">Sign in</a>
          <a href="/account.html?next=%2F">Create a free account</a>
        </div>
      </div>
    </section>

    <section class="pd-home-section" id="pdResume" hidden><h2>Pick up where you left off</h2><div id="pdResumeItems" class="pd-resume-items"></div><p class="fine">Recent tools and flights are saved on this device.</p></section>
    <section class="pd-home-section" id="popular-tools">
      <div class="pd-home-section-head">
        <div><h2>Popular tools</h2><p>The things pilots reach for most.</p></div>
        <a href="/tools.html">All calculators →</a>
      </div>
      <div class="pd-popular-grid">
        {popularTools.map(([href, title, path]) => (
          <a class="pd-popular-tool" href={href}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span>{title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pd-home-section" aria-labelledby="pdHomeExploreTitle">
      <div class="pd-home-section-head"><div><h2 id="pdHomeExploreTitle">Four ways into PilotDesk.</h2><p>Start with the job in front of you.</p></div></div>
      <div class="pd-popular-grid">
        {homeCategories.map(([href, title, copy, path]) => (
          <a class="pd-popular-tool" href={href}><svg viewBox="0 0 32 32" aria-hidden="true"><path d={path} /></svg><span><b>{title}</b><small>{copy}</small></span></a>
        ))}
      </div>
    </section>

    <section class="pd-home-section pd-learning-promo"><div><div class="eyebrow">LEARN A LITTLE, EVERY DAY</div><h2>Make your next study session count.</h2><p>Choose your rating, try a sample, and build confidence with explanations and weak-area review.</p><a class="pd-btn" href="/flight-training.html">Find your study path</a> <a href="/daily/">Play Daily →</a></div></section>
    <section class="pd-home-section pd-home-discovery"><div class="pd-home-section-head"><div><h2>Explore PilotDesk</h2><p>Move from today’s task to the next useful step.</p></div></div><div class="pd-popular-grid"><a class="pd-popular-tool" href="/written-prep.html"><span><b>Written Prep</b><small>Practice PPL through ATP subjects.</small></span></a><a class="pd-popular-tool" href="/daily/"><span><b>PilotDesk Daily</b><small>Three aviation questions and a learning streak.</small></span></a><a class="pd-popular-tool" href="/flight-training.html"><span><b>Flight Training</b><small>Organize your study path by rating.</small></span></a></div></section>
    <section class="pd-home-section"><h2>Know where your numbers come from.</h2><p>Methods, assumptions, and source links accompany the tools. Use current approved information for operational decisions.</p><a href="/sources.html">Sources and methods →</a></section>
    <section class="pd-home-section pd-home-faq" aria-labelledby="faq-title"><div class="pd-home-section-head"><div><h2 id="faq-title">PilotDesk questions</h2><p>Short answers before you start planning or studying.</p></div></div><div class="pd-faq-list"><details><summary>What aviation tools does PilotDesk include?</summary><p>Flight planning, aviation calculators, weather references, aircraft performance tools, and pilot study resources.</p></details><details><summary>Are calculator results official operational data?</summary><p>No. Results are planning aids based on the inputs and methods shown. Verify decisions with current approved aircraft, airport, weather, and regulatory sources.</p></details><details><summary>Can I use PilotDesk for FAA written test preparation?</summary><p>Yes. Rating-focused practice includes explanations and weak-area review.</p></details></div></section>
  </div>
</BaseLayout>
